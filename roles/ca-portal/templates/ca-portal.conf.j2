map $host $portal_root {
    {{ ca_portal_hostname }}      {{ ca_portal_web_root }};
    packages.homelab.internal  {{ portal_packages_dir }};
}

server {
    listen {{ portal_http_port }};
    server_name {{ ca_portal_hostname }} packages.homelab.internal;

    location /.well-known/acme-challenge/ {
        root {{ ca_portal_acme_dir }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen {{ portal_https_port }} ssl;
    server_name {{ ca_portal_hostname }} packages.homelab.internal;

    ssl_certificate     {{ ca_portal_ssl_cert }};
    ssl_certificate_key {{ ca_portal_ssl_key }};

    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;

    root $portal_root;

    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    location /ca/ {
        alias {{ ca_portal_ca_dir }}/;
        add_header Content-Disposition "attachment";
        add_header Content-Type "application/x-x509-ca-cert";
    }

    location /acme/ {
        proxy_pass https://127.0.0.1:{{ step_ca_port | default(9000) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        index index.html;
        try_files $uri $uri/ =404;
    }
}
