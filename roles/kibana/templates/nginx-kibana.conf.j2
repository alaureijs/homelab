server {
    listen 443 ssl;
    http2 on;
    server_name observability.homelab.internal;

    ssl_certificate {{ kibana_nginx_cert_path }};
    ssl_certificate_key {{ kibana_nginx_key_path }};
    ssl_client_certificate {{ kibana_nginx_mtls_ca }};
    ssl_verify_client optional;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        return 308 https://$host/kibana/;
    }

    # Kibana
    location /kibana/ {
        proxy_pass http://127.0.0.1:{{ kibana_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Elasticsearch (OTel collector writes, mTLS required)
    location /elasticsearch/ {
        if ($ssl_client_verify != SUCCESS) {
            return 400;
        }
        client_max_body_size 20m;
        proxy_pass http://127.0.0.1:{{ elasticsearch_http_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name observability.homelab.internal;
    return 308 https://$host$request_uri;
}
