map $host $portal_root {
    pki.homelab.internal       {{ nginx_web_root }}/ca-portal;
    packages.homelab.internal  {{ nginx_web_root }}/packages;
}

server {
    listen {{ nginx_http_port }};
    server_name pki.homelab.internal packages.homelab.internal;

    location /.well-known/acme-challenge/ {
        root {{ nginx_web_root }}/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen {{ nginx_https_port }} ssl;
    server_name pki.homelab.internal packages.homelab.internal;

    ssl_certificate     {{ nginx_ssl_cert }};
    ssl_certificate_key {{ nginx_ssl_key }};

    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;

    root $portal_root;

    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    location /ca/ {
        alias {{ nginx_web_root }}/ca/;
        add_header Content-Disposition "attachment";
        add_header Content-Type "application/x-x509-ca-cert";
    }

    location /acme/ {
        proxy_pass https://127.0.0.1:{{ step_ca_port | default(9000) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        index index.html;
        try_files $uri $uri/ =404;
    }
}
