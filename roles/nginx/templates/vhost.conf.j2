server {
    listen {{ nginx_http_port }};
    server_name {{ vhost.server_name }};

{% if vhost.acme_challenge | default(false) %}
    location /.well-known/acme-challenge/ {
        root {{ nginx_web_root }}/acme;
    }
{% endif %}

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen {{ nginx_https_port }} ssl;
    server_name {{ vhost.server_name }};

    ssl_certificate     {{ vhost.ssl_cert }};
    ssl_certificate_key {{ vhost.ssl_key }};

    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;

    root {{ vhost.web_root }};

{% if vhost.ca_alias | default(false) %}
    location /ca/ {
        alias {{ nginx_web_root }}/ca/;
        add_header Content-Disposition "attachment";
        add_header Content-Type "application/x-x509-ca-cert";
    }
{% endif %}

{% if vhost.acme_proxy | default(false) %}
    location /acme/ {
        proxy_pass https://127.0.0.1:{{ step_ca_port | default(9000) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}

{% if vhost.autoindex | default(false) %}
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;
{% endif %}

    location / {
{% if vhost.landing_page %}
        index index.html;
{% endif %}
        try_files $uri $uri/ =404;
    }
}
